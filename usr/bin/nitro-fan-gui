        self.g_gpu_fan = GaugeWidget("GPU FAN", "%", 100)
        self.g_mode = GaugeWidget("TARGET", "%", 100)
        g_layout.addWidget(self.g_cpu, 0, 0)
        g_layout.addWidget(self.g_cpu_fan, 0, 1)
        g_layout.addWidget(self.g_gpu_fan, 0, 2)
        g_layout.addWidget(self.g_mode, 0, 3)
        layout.addWidget(gauges_card)

        info_card = Card()
        info_l = QHBoxLayout(info_card)
        info_l.setContentsMargins(16, 10, 16, 10)
        self.lbl_config = QLabel("Config: —")
        self.lbl_config.setObjectName("info")
        self.lbl_rpm = QLabel("RPM: —")
        self.lbl_rpm.setObjectName("info")
        self.lbl_mode = QLabel("Rejim: —")
        self.lbl_mode.setObjectName("info")
        info_l.addWidget(self.lbl_config)
        info_l.addStretch()
        info_l.addWidget(self.lbl_mode)
        info_l.addStretch()
        info_l.addWidget(self.lbl_rpm)
        layout.addWidget(info_card)

        # System / warnings
