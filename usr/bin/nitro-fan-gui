    def set_status(self, msg: str, ok: bool = True):
        color = ACCENT if ok else HOT
        self.status_bar.setText(msg)
        self.status_bar.setStyleSheet(f"color: {color}; font-size: 11px; padding: 2px 4px;")

    def _update_model_subtitle(self):
        """Show DMI model once; non-fatal if missing."""
        if getattr(self, "_model_set", False):
            return
        model = ""
        for path in (
            "/sys/class/dmi/id/product_name",
            "/sys/class/dmi/id/sys_vendor",
        ):
            try:
                model = (model + " " + Path(path).read_text().strip()).strip()
            except Exception:
                pass
        if model:
            rgb = "RGB+" if os.path.exists(DEV_DYN) else "monitor"
            self.lbl_subtitle.setText(f"{model}  ·  Kali universal ({rgb})")
            self._model_set = True

    def refresh(self):
        if self._applying:
            return
        st = fetch_status()
        self._update_model_subtitle()

        if st.service_active:
            self.badge.setText("● FAN OK")
            self.badge.setStyleSheet(
                f"background:{PANEL2};border:1px solid {ACCENT};border-radius:14px;"
                f"padding:6px 12px;font-weight:700;font-size:11px;color:{ACCENT};"
            )
        else:
            self.badge.setText("● FAN OFF")
            self.badge.setStyleSheet(
                f"background:{PANEL2};border:1px solid {HOT};border-radius:14px;"
                f"padding:6px 12px;font-weight:700;font-size:11px;color:{HOT};"
            )

        if st.rgb_ok:
            self.badge_rgb.setText("● RGB OK")
            self.badge_rgb.setStyleSheet(
                f"background:{PANEL2};border:1px solid {ACCENT2};border-radius:14px;"
                f"padding:6px 12px;font-weight:700;font-size:11px;color:{ACCENT2};"
            )
        else:
            self.badge_rgb.setText("● RGB YO'Q")
            self.badge_rgb.setStyleSheet(
                f"background:{PANEL2};border:1px solid {HOT};border-radius:14px;"
                f"padding:6px 12px;font-weight:700;font-size:11px;color:{HOT};"
            )

        cpu = st.cpu_temp
        if cpu is None and st.fans:
            cpu = st.fans[0].temperature
        self.g_cpu.set_value(cpu or 0, "Package" if st.cpu_temp else "NBFC")

        cpu_fan = st.fans[0] if len(st.fans) > 0 else None
        gpu_fan = st.fans[1] if len(st.fans) > 1 else None
        if cpu_fan:
            self.g_cpu_fan.set_value(cpu_fan.current, f"→ {cpu_fan.target:.0f}%")
        if gpu_fan:
            self.g_gpu_fan.set_value(gpu_fan.current, f"→ {gpu_fan.target:.0f}%")

        target, auto = 0.0, False
        if cpu_fan:
            target, auto = cpu_fan.target, cpu_fan.auto
        self.g_mode.set_value(target, "AUTO" if auto else "MANUAL")

        self.lbl_config.setText(f"Config: {st.config or '—'}")
        self.lbl_mode.setText(
            f"Rejim: {'AUTO (temp)' if auto else 'MANUAL'}"
        )
        rpm_parts = []
        if st.fan1_rpm is not None:
            rpm_parts.append(f"CPU {st.fan1_rpm}")
        if st.fan2_rpm is not None:
            rpm_parts.append(f"GPU {st.fan2_rpm}")
        self.lbl_rpm.setText("RPM: " + (" · ".join(rpm_parts) if rpm_parts else "—"))

        # RAM / SSD labels
        if st.mem_percent is not None:
            self.lbl_ram.setText(
                f"RAM: {st.mem_percent:.0f}%  ({st.mem_used_gb:.1f}/{st.mem_total_gb:.0f} GB)"
            )
            if st.mem_percent >= 90:
                self.lbl_ram.setStyleSheet(f"color: {HOT}; font-weight: 700;")
            elif st.mem_percent >= 80:
                self.lbl_ram.setStyleSheet(f"color: {WARN}; font-weight: 700;")
            else:
                self.lbl_ram.setStyleSheet(f"color: {MUTED};")
        if st.swap_percent is not None:
            self.lbl_swap.setText(f"Swap: {st.swap_percent:.0f}%")
            if st.swap_percent >= 50:
                self.lbl_swap.setStyleSheet(f"color: {HOT}; font-weight: 700;")
            elif st.swap_percent >= 20:
                self.lbl_swap.setStyleSheet(f"color: {WARN}; font-weight: 700;")
            else:
                self.lbl_swap.setStyleSheet(f"color: {MUTED};")
        if st.nvme_temp is not None:
            self.lbl_nvme.setText(f"SSD: {st.nvme_temp:.0f}°C")
            if st.nvme_temp >= 75:
                self.lbl_nvme.setStyleSheet(f"color: {HOT}; font-weight: 700;")
            elif st.nvme_temp >= 65:
                self.lbl_nvme.setStyleSheet(f"color: {WARN}; font-weight: 700;")
            else:
                self.lbl_nvme.setStyleSheet(f"color: {MUTED};")
        else:
            self.lbl_nvme.setText("SSD: —")

        self._handle_alerts(st)

        if st.error:
            self.set_status(st.error, ok=False)

    def _handle_alerts(self, st: Status):
        warnings: List[str] = []
        critical = False
        if st.mem_percent is not None and st.mem_percent >= 90:
            warnings.append(f"RAM {st.mem_percent:.0f}% to'ldi — og'ir dasturlarni yoping")
            critical = True
        elif st.mem_percent is not None and st.mem_percent >= 80:
            warnings.append(f"RAM {st.mem_percent:.0f}% — yuqori")
        if st.swap_percent is not None and st.swap_percent >= 40:
            warnings.append(f"Swap {st.swap_percent:.0f}% — SSD zo'riqyapti")
            critical = True
        if st.cpu_temp is not None and st.cpu_temp >= 90:
            warnings.append(f"CPU {st.cpu_temp:.0f}°C — juda issiq")
            critical = True
        elif st.cpu_temp is not None and st.cpu_temp >= 80:
            warnings.append(f"CPU {st.cpu_temp:.0f}°C — issiq")
        if st.nvme_temp is not None and st.nvme_temp >= 75:
            warnings.append(f"SSD {st.nvme_temp:.0f}°C — xavfli issiqlik")
            critical = True

        if warnings:
            self.lbl_alert.setText("⚠  " + "  ·  ".join(warnings))
            self.lbl_alert.setVisible(True)
            key = "|".join(warnings)
            if critical and key != self._last_alert_key:
                self._last_alert_key = key
                self.set_status(warnings[0], ok=False)
                # Auto boost fans once per alert wave
                if not self._auto_boosted and shutil.which("nbfc"):
                    nbfc_set_speed(100)
                    self._auto_boosted = True
                    self.set_status(warnings[0] + "  → fan 100%", ok=False)
        else:
            self.lbl_alert.setVisible(False)
            self.lbl_alert.setText("")
            if self._auto_boosted:
                # cool enough — back to auto
                nbfc_set_auto()
                self._auto_boosted = False
                self._last_alert_key = ""
                self.set_status("Normal — fan AUTO", ok=True)

    def on_auto(self):
        self._applying = True
        ok, err = nbfc_set_auto()
        self._applying = False
        self.set_status("AUTO rejim" if ok else f"Xato: {err}", ok)
        if not ok:
            QMessageBox.warning(self, "Xato", err or "auto ishlamadi")
        self.refresh()

    def apply_speed(self, percent: int):
        self._applying = True
        ok, err = nbfc_set_speed(percent)
        self._applying = False
        self.slider.setValue(percent)
        self.set_status(f"Fan: {percent}%" if ok else f"Xato: {err}", ok)
        if not ok:
            QMessageBox.warning(self, "Xato", err or "set ishlamadi")
        self.refresh()


def make_app_icon() -> QIcon:
    pm = QPixmap(128, 128)
    pm.fill(Qt.transparent)
    p = QPainter(pm)
    p.setRenderHint(QPainter.Antialiasing)
    grad = QRadialGradient(64, 64, 60)
    grad.setColorAt(0, QColor("#123025"))
    grad.setColorAt(1, QColor("#0b0f14"))
    p.setBrush(grad)
    p.setPen(QPen(QColor(ACCENT), 4))
    p.drawEllipse(8, 8, 112, 112)
    p.setPen(Qt.NoPen)
    p.setBrush(QColor(ACCENT))
    p.translate(64, 64)
    for _ in range(3):
        p.rotate(120)
        path = QPainterPath()
        path.moveTo(0, 0)
        path.cubicTo(18, -8, 36, -28, 12, -42)
        path.cubicTo(8, -20, 4, -10, 0, 0)
        p.drawPath(path)
    p.setBrush(QColor(ACCENT2))
    p.drawEllipse(-8, -8, 16, 16)
    p.end()
    return QIcon(pm)


def main():
    QApplication.setAttribute(Qt.AA_EnableHighDpiScaling, True)
    QApplication.setAttribute(Qt.AA_UseHighDpiPixmaps, True)
    app = QApplication(sys.argv)
    app.setApplicationName("Nitro Control")
    icon = make_app_icon()
    app.setWindowIcon(icon)
    win = NitroFanWindow()
    win.setWindowIcon(icon)
    win.show()
    sys.exit(app.exec_())


if __name__ == "__main__":
    main()
