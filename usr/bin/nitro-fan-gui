    def _build_rgb_tab(self) -> QWidget:
        w = QWidget()
        layout = QVBoxLayout(w)
        layout.setContentsMargins(4, 10, 4, 4)
        layout.setSpacing(12)

        # Preview
        prev = Card()
        pl = QVBoxLayout(prev)
        pl.setContentsMargins(16, 14, 16, 14)
        self.preview = QLabel("  KLAVIATURA RANGI  ")
        self.preview.setAlignment(Qt.AlignCenter)
        self.preview.setMinimumHeight(72)
        self.preview.setObjectName("preview")
        self._update_preview()
        pl.addWidget(self.preview)

        sw_row = QHBoxLayout()
        sw_row.addWidget(QLabel("Tez ranglar:"))
        presets = [
            (255, 0, 0), (255, 80, 0), (255, 200, 0), (0, 255, 0),
            (0, 230, 118), (0, 200, 255), (0, 80, 255), (180, 0, 255),
            (255, 0, 180), (255, 255, 255),
        ]
        for rgb in presets:
            sw = ColorSwatch(*rgb)
            sw.clicked.connect(lambda _=False, c=rgb: self._pick_preset(*c))
            sw_row.addWidget(sw)
        sw_row.addStretch()
        self.btn_picker = PillButton("RANG TANLASH…", "secondary")
        self.btn_picker.clicked.connect(self.on_color_picker)
        sw_row.addWidget(self.btn_picker)
        pl.addLayout(sw_row)
        layout.addWidget(prev)

        # Effects
        eff = Card()
        el = QVBoxLayout(eff)
        el.setContentsMargins(16, 14, 16, 14)
        el.setSpacing(10)
        el.addWidget(QLabel("Effektlar (Windows Nitro Sense kabi):"))

        modes = QHBoxLayout()
        self.btn_static = PillButton("STATIC", "primary")
        self.btn_breath = PillButton("BREATH", "secondary")
        self.btn_neon = PillButton("NEON", "secondary")
        self.btn_wave = PillButton("WAVE", "secondary")
        self.btn_shift = PillButton("SHIFT", "secondary")
        self.btn_zoom = PillButton("ZOOM", "secondary")
        self.btn_off = PillButton("O'CHIRISH", "danger")
        self.btn_static.clicked.connect(self.on_static)
        self.btn_breath.clicked.connect(lambda: self.on_effect(1))
        self.btn_neon.clicked.connect(lambda: self.on_effect(2))
        self.btn_wave.clicked.connect(lambda: self.on_effect(3))
        self.btn_shift.clicked.connect(lambda: self.on_effect(4))
        self.btn_zoom.clicked.connect(lambda: self.on_effect(5))
        self.btn_off.clicked.connect(self.on_rgb_off)
