def run_cmd(args: List[str], timeout: float = 8.0) -> subprocess.CompletedProcess:
    return subprocess.run(
        args, capture_output=True, text=True, timeout=timeout, check=False
    )


@dataclass
class FanInfo:
    name: str = ""
    temperature: float = 0.0
    auto: bool = False
    current: float = 0.0
    target: float = 0.0


@dataclass
class Status:
    service_active: bool = False
    config: str = ""
    fans: List[FanInfo] = field(default_factory=list)
    cpu_temp: Optional[float] = None
    fan1_rpm: Optional[int] = None
    fan2_rpm: Optional[int] = None
    error: str = ""
    rgb_ok: bool = False
    mem_percent: Optional[float] = None
    mem_used_gb: Optional[float] = None
    mem_total_gb: Optional[float] = None
    swap_percent: Optional[float] = None
    nvme_temp: Optional[float] = None


def parse_nbfc_status(text: str) -> List[FanInfo]:
    fans: List[FanInfo] = []
    current: Optional[FanInfo] = None
    for line in text.splitlines():
        line = line.strip()
        if line.startswith("Fan Display Name"):
            if current:
                fans.append(current)
            current = FanInfo(name=line.split(":", 1)[1].strip())
        elif current is None:
            continue
        elif line.startswith("Temperature"):
            try:
                current.temperature = float(line.split(":", 1)[1].strip())
            except ValueError:
                pass
        elif line.startswith("Auto Control Enabled"):
            current.auto = "true" in line.split(":", 1)[1].strip().lower()
        elif line.startswith("Current Fan Speed"):
            try:
                current.current = float(line.split(":", 1)[1].strip())
            except ValueError:
                pass
        elif line.startswith("Target Fan Speed"):
            try:
                current.target = float(line.split(":", 1)[1].strip())
            except ValueError:
                pass
    if current:
        fans.append(current)
    return fans


def parse_sensors() -> tuple[Optional[float], Optional[int], Optional[int], Optional[float]]:
    if not shutil.which("sensors"):
        return None, None, None, None
    try:
        out = run_cmd(["sensors"]).stdout
    except Exception:
        return None, None, None, None
    cpu = fan1 = fan2 = nvme = None
    m = re.search(r"Package id 0:\s*\+?([0-9.]+)", out)
    if m:
        cpu = float(m.group(1))
    m = re.search(r"fan1:\s*([0-9]+)\s*RPM", out)
    if m:
        fan1 = int(m.group(1))
    m = re.search(r"fan2:\s*([0-9]+)\s*RPM", out)
    if m:
        fan2 = int(m.group(1))
    # NVMe composite temp (often first Composite under nvme)
    m = re.search(r"nvme-.*\n(?:.*\n)*?Composite:\s*\+?([0-9.]+)", out)
    if not m:
        m = re.search(r"Composite:\s*\+?([0-9.]+)", out)
    if m:
        nvme = float(m.group(1))
    return cpu, fan1, fan2, nvme


def parse_memory() -> tuple[Optional[float], Optional[float], Optional[float], Optional[float]]:
    """Return mem_percent, used_gb, total_gb, swap_percent."""
    try:
        meminfo = Path("/proc/meminfo").read_text()
    except Exception:
        return None, None, None, None
    vals: dict[str, int] = {}
    for line in meminfo.splitlines():
        parts = line.split()
        if len(parts) >= 2 and parts[0].endswith(":"):
            try:
                vals[parts[0][:-1]] = int(parts[1])  # kB
            except ValueError:
                pass
    total = vals.get("MemTotal")
    avail = vals.get("MemAvailable")
    if not total or avail is None:
        return None, None, None, None
    used = total - avail
    mem_pct = 100.0 * used / total
    used_gb = used / (1024 * 1024)
    total_gb = total / (1024 * 1024)
    st = vals.get("SwapTotal", 0)
    sf = vals.get("SwapFree", 0)
    swap_pct = 0.0 if st == 0 else 100.0 * (st - sf) / st
    return mem_pct, used_gb, total_gb, swap_pct


def fetch_status() -> Status:
    st = Status()
    st.rgb_ok = os.path.exists(DEV_DYN)
    try:
        svc = run_cmd(["systemctl", "is-active", "nbfc_service"])
        st.service_active = svc.stdout.strip() == "active"
    except Exception:
        st.service_active = False

    st.mem_percent, st.mem_used_gb, st.mem_total_gb, st.swap_percent = parse_memory()

    if not shutil.which("nbfc"):
        st.error = "nbfc topilmadi. Terminal: sudo nitro-fan install-nbfc"
        st.cpu_temp, st.fan1_rpm, st.fan2_rpm, st.nvme_temp = parse_sensors()
        return st

    try:
        p = run_cmd(["nbfc", "status", "-a"])
        if p.returncode != 0 and not p.stdout:
            p = run_cmd(["nbfc", "status"])
        text = p.stdout or p.stderr
        for line in text.splitlines():
            if "Selected Config Name" in line:
                st.config = line.split(":", 1)[1].strip()
        st.fans = parse_nbfc_status(text)
        if p.returncode != 0 and not st.fans:
            st.error = (p.stderr or p.stdout or "nbfc status xato").strip()
    except Exception as e:
        st.error = str(e)

    st.cpu_temp, st.fan1_rpm, st.fan2_rpm, st.nvme_temp = parse_sensors()
    return st


def nbfc_set_auto() -> Tuple[bool, str]:
    p = run_cmd(["nbfc", "set", "-a"])
    if p.returncode != 0:
        p = run_cmd(["nbfc", "set", "--auto"])
    return p.returncode == 0, (p.stderr or p.stdout or "").strip()


def nbfc_set_speed(percent: int) -> Tuple[bool, str]:
    p = run_cmd(["nbfc", "set", "-s", str(int(percent))])
    return p.returncode == 0, (p.stderr or p.stdout or "").strip()


def rgb_available() -> bool:
    return os.path.exists(DEV_DYN) and os.path.exists(DEV_STATIC)


def set_static_color(r: int, g: int, b: int, brightness: int = 100) -> Tuple[bool, str]:
    """All 4 zones static color via character devices."""
    if not rgb_available():
        return False, "RGB modul yo'q (/dev/acer-gkbbl-*). turbo-fan service?"
    try:
        for zone in range(1, 5):
            payload = [0] * 4
            payload[0] = 1 << (zone - 1)
            payload[1] = max(0, min(255, r))
            payload[2] = max(0, min(255, g))
            payload[3] = max(0, min(255, b))
            with open(DEV_STATIC, "wb") as cd:
                cd.write(bytes(payload))
        # enable static mode + brightness
        dyn = [0] * 16
        dyn[2] = max(0, min(100, brightness))
        dyn[9] = 1
        with open(DEV_DYN, "wb") as cd:
            cd.write(bytes(dyn))
        return True, f"RGB: #{r:02X}{g:02X}{b:02X}  b={brightness}"
    except Exception as e:
        return False, str(e)


def set_effect(
    mode: int,
    speed: int = 4,
    brightness: int = 100,
    direction: int = 1,
    r: int = 0,
    g: int = 255,
    b: int = 0,
) -> Tuple[bool, str]:
    if not rgb_available():
        return False, "RGB modul yo'q"
    if mode == 0:
        return set_static_color(r, g, b, brightness)
    try:
        payload = [0] * 16
        payload[0] = mode
        payload[1] = max(0, min(255, speed))
        payload[2] = max(0, min(100, brightness))
        payload[3] = 8 if mode == 3 else 0
        payload[4] = direction
        payload[5] = max(0, min(255, r))
        payload[6] = max(0, min(255, g))
        payload[7] = max(0, min(255, b))
        payload[9] = 1
        with open(DEV_DYN, "wb") as cd:
            cd.write(bytes(payload))
        names = {1: "Breath", 2: "Neon", 3: "Wave", 4: "Shift", 5: "Zoom"}
        return True, f"Effekt: {names.get(mode, mode)}"
    except Exception as e:
        return False, str(e)


# ── Widgets ────────────────────────────────────────────────────────────────

class GaugeWidget(QWidget):
    def __init__(self, title: str = "", unit: str = "°C", max_val: float = 100, parent=None):
        super().__init__(parent)
        self.title = title
        self.unit = unit
        self.max_val = max_val
        self.value = 0.0
        self.subtitle = ""
        self.setMinimumSize(140, 150)
        self.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Expanding)

    def set_value(self, value: float, subtitle: str = ""):
        self.value = max(0.0, float(value))
        self.subtitle = subtitle
        self.update()

    def _color_for(self, ratio: float) -> QColor:
        if ratio < 0.45:
            return QColor(ACCENT)
        if ratio < 0.7:
            return QColor(WARN)
        return QColor(HOT)

    def paintEvent(self, _event):
        p = QPainter(self)
        p.setRenderHint(QPainter.Antialiasing)
        w, h = self.width(), self.height()
        side = min(w, h - 28)
        cx, cy = w / 2, (h - 10) / 2
        radius = side / 2 - 10
        ratio = min(1.0, self.value / self.max_val) if self.max_val else 0
        color = self._color_for(ratio)

        pen = QPen(QColor(TRACK), 10, Qt.SolidLine, Qt.RoundCap)
        p.setPen(pen)
        rect = QRectF(cx - radius, cy - radius, radius * 2, radius * 2)
        start_angle = 225 * 16
        span = -270 * 16
        p.drawArc(rect, start_angle, span)

        pen = QPen(color, 10, Qt.SolidLine, Qt.RoundCap)
        p.setPen(pen)
        p.drawArc(rect, start_angle, int(span * ratio))

        grad = QRadialGradient(cx, cy, radius * 0.7)
        c = QColor(color)
        c.setAlpha(35)
        grad.setColorAt(0, c)
        grad.setColorAt(1, QColor(0, 0, 0, 0))
        p.setPen(Qt.NoPen)
        p.setBrush(grad)
        p.drawEllipse(QPointF(cx, cy), radius * 0.65, radius * 0.65)

        p.setPen(QColor(TEXT))
        font = QFont("Sans Serif", 17, QFont.Bold)
        p.setFont(font)
        p.drawText(rect.adjusted(0, 8, 0, 0), Qt.AlignCenter, f"{self.value:.0f}{self.unit}")

        p.setPen(QColor(MUTED))
        p.setFont(QFont("Sans Serif", 9))
        p.drawText(QRectF(0, h - 22, w, 18), Qt.AlignHCenter | Qt.AlignVCenter, self.title)

        if self.subtitle:
            p.setPen(QColor(MUTED))
            p.setFont(QFont("Sans Serif", 8))
            p.drawText(QRectF(0, cy + radius * 0.25, w, 16), Qt.AlignHCenter, self.subtitle)


class Card(QFrame):
    def __init__(self, parent=None):
        super().__init__(parent)
        self.setObjectName("card")
        shadow = QGraphicsDropShadowEffect(self)
        shadow.setBlurRadius(24)
        shadow.setOffset(0, 6)
        shadow.setColor(QColor(0, 0, 0, 120))
        self.setGraphicsEffect(shadow)


class PillButton(QPushButton):
    def __init__(self, text: str, kind: str = "primary", parent=None):
        super().__init__(text, parent)
        self.setCursor(Qt.PointingHandCursor)
        self.setMinimumHeight(40)
        self.setObjectName(f"btn_{kind}")


class ColorSwatch(QPushButton):
    def __init__(self, r: int, g: int, b: int, parent=None):
        super().__init__(parent)
        self.rgb = (r, g, b)
        self.setFixedSize(36, 36)
        self.setCursor(Qt.PointingHandCursor)
        self.setStyleSheet(
            f"QPushButton {{ background: rgb({r},{g},{b}); border: 2px solid {BORDER};"
            f" border-radius: 8px; }}"
            f"QPushButton:hover {{ border: 2px solid {ACCENT}; }}"
        )


# ── Main window ────────────────────────────────────────────────────────────

class NitroFanWindow(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Nitro Control — Fan + RGB")
        self.setMinimumSize(760, 620)
        self.resize(820, 660)
        self._applying = False
        self._color = QColor(0, 230, 118)  # nitro green
        self._last_alert_key = ""
        self._auto_boosted = False
        self._build_ui()
        self._apply_style()
        self.refresh()
        self.timer = QTimer(self)
        self.timer.timeout.connect(self.refresh)
        self.timer.start(2000)

    def _build_ui(self):
        root = QWidget()
        self.setCentralWidget(root)
        layout = QVBoxLayout(root)
        layout.setContentsMargins(18, 14, 18, 14)
        layout.setSpacing(12)

        # Header
        header = QHBoxLayout()
        title_box = QVBoxLayout()
        title = QLabel("NITRO CONTROL")
        title.setObjectName("title")
        self.lbl_subtitle = QLabel("Kali universal  ·  Fan + RGB + Monitor")
        self.lbl_subtitle.setObjectName("subtitle")
        title_box.addWidget(title)
        title_box.addWidget(self.lbl_subtitle)
        header.addLayout(title_box)
        header.addStretch()
        self.badge = QLabel("● SERVICE")
        self.badge.setObjectName("badge")
        self.badge_rgb = QLabel("● RGB")
        self.badge_rgb.setObjectName("badge")
        header.addWidget(self.badge)
        header.addWidget(self.badge_rgb)
        layout.addLayout(header)

        tabs = QTabWidget()
        tabs.setObjectName("tabs")
        tabs.addTab(self._build_fan_tab(), "  🌡  FAN  ")
        tabs.addTab(self._build_rgb_tab(), "  💡  KLAVIATURA RGB  ")
        layout.addWidget(tabs, 1)

        self.status_bar = QLabel("Tayyor")
        self.status_bar.setObjectName("statusbar")
        layout.addWidget(self.status_bar)

    def _build_fan_tab(self) -> QWidget:
        w = QWidget()
        layout = QVBoxLayout(w)
        layout.setContentsMargins(4, 10, 4, 4)
        layout.setSpacing(12)

