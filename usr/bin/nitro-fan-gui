        )
        tip.setObjectName("tip")
        tip.setWordWrap(True)
        el.addWidget(tip)
        layout.addWidget(eff)
        layout.addStretch()
        return w

    def _update_preview(self):
        c = self._color
        self.preview.setStyleSheet(
            f"QLabel#preview {{ background: qlineargradient(x1:0,y1:0,x2:1,y2:0,"
            f" stop:0 rgb({c.red()//3},{c.green()//3},{c.blue()//3}),"
            f" stop:0.5 rgb({c.red()},{c.green()},{c.blue()}),"
            f" stop:1 rgb({c.red()//3},{c.green()//3},{c.blue()//3}));"
            f" color: white; font-size: 16px; font-weight: 800; letter-spacing: 2px;"
            f" border-radius: 12px; border: 1px solid {BORDER}; padding: 18px; }}"
        )

    def _pick_preset(self, r: int, g: int, b: int):
        self._color = QColor(r, g, b)
        self._update_preview()
        self.on_static()

    def on_color_picker(self):
        c = QColorDialog.getColor(self._color, self, "Klaviatura rangi")
        if c.isValid():
            self._color = c
            self._update_preview()
            self.on_static()

    def on_static(self):
        c = self._color
        ok, msg = set_static_color(c.red(), c.green(), c.blue(), self.sld_bri.value())
        self.set_status(msg, ok)

    def on_effect(self, mode: int):
        c = self._color
        ok, msg = set_effect(
            mode,
            speed=self.sld_spd.value(),
            brightness=self.sld_bri.value(),
            r=c.red(),
            g=c.green(),
            b=c.blue(),
        )
        self.set_status(msg, ok)

    def on_rgb_off(self):
        ok, msg = set_static_color(0, 0, 0, 0)
        # also force brightness 0 dynamic
        if rgb_available():
            try:
                payload = [0] * 16
                payload[2] = 0
                payload[9] = 1
                with open(DEV_DYN, "wb") as cd:
                    cd.write(bytes(payload))
            except Exception:
                pass
        self.set_status("Klaviatura RGB o'chirildi" if ok else msg, ok)

