        self.sld_bri.valueChanged.connect(lambda v: self.lbl_bri.setText(f"Yorqinlik: {v}"))
        sl.addWidget(self.lbl_bri)
        sl.addWidget(self.sld_bri, 1)
        el.addLayout(sl)

        sl2 = QHBoxLayout()
